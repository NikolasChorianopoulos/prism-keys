# Settings used by scripts/build-app.sh and scripts/release.sh

# Your GitHub repository, e.g. "yourname/prism-keys". Leave empty until you create it.
GITHUB_REPO="NikolasChorianopoulos/prism-keys"

# Sparkle EdDSA public key. Filled in by scripts/setup-updates.sh.
# (The private key stays in your login Keychain and must never be committed.)
SPARKLE_PUBLIC_KEY=""

# The app's internal ID. Final: changing it after release makes macOS treat it as a different
# app (users would lose their permissions and stop receiving updates).
BUNDLE_ID="app.prismkeys.PrismKeys"

# Code signing identity. "Prism Keys Developer" is a self-signed certificate in your login
# Keychain; signing every build with it lets macOS keep permissions across updates.
# Back it up (Keychain Access → My Certificates → export .p12) — updates must use the same one.
# Use "-" for ad-hoc, or a "Developer ID Application: …" identity for notarized builds.
SIGN_IDENTITY="Prism Keys Developer"
